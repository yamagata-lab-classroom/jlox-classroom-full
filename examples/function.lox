fun call(name, place) {
  print "私" + name + "。今、" + place + "にいるの";
}
call("メリーさん", "あなたの家の前");
print call("メリーさん", "あなたの後ろ");  // return がないので nil

fun fibonacci(num) {
  var a = 0;
  var b = 1;
  for (var i = 0; i < num; i = i + 1) {
    var temp = a;
    a = b;
    b = temp + b;
  }
  return a;
}
print fibonacci(10);  // 55
